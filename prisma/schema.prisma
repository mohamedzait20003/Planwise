// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// Federated identity providers. Credentials sign-in is not listed: it is the
/// absence of an OAuthAccount plus a non-null passwordHash.
enum AuthProvider {
  GOOGLE
}

model User {
  Id           String   @id @default(cuid())
  FName        String
  LName        String

  Email        String   @unique
  passwordHash String?

  userName     String?  @unique
  AvatarUrl    String?
  Role         Role     @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emailVerifiedAt DateTime?
  
  dataVersion  Int      @default(0)

  plans         Plan[]
  actuals       Actual[]
  categories    Category[]
  periodLocks   PeriodLock[]
  reportRuns    ReportRun[]

  passwordResets     PasswordReset?
  emailVerifications EmailVerification?
  oauthAccounts      OAuthAccount[]

  @@map("users")
}

model OAuthAccount {
  Id       String       @id @default(cuid())
  userId   String

  provider AuthProvider
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [Id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordReset {
  Id        String   @id @default(cuid())
  userId    String   @unique

  tokenHash String   @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [Id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  Id        String   @id @default(cuid())
  userId    String   @unique

  tokenHash String   @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [Id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verifications")
}

model Category {
  id         String    @id @default(cuid())
  userId     String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [Id], onDelete: Cascade)
  plans   Plan[]
  actuals Actual[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@map("categories")
}

model Plan {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  periodMonth DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [Id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, categoryId, periodMonth]) 
  @@index([userId, periodMonth])
  @@map("plans")
}

model Actual {
  id            String       @id @default(cuid())
  userId        String
  categoryId    String
  periodMonth   DateTime     @db.Date
  amount        Decimal      @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Soft delete. An entry is a claim about what was spent, and a locked month
  /// has to be able to prove what it contained — including that a row was
  /// removed and by whom the removal was permitted. Null means live; every read
  /// filters on it, so a deleted entry leaves the report and the totals at once.
  deletedAt     DateTime?

  user        User         @relation(fields: [userId], references: [Id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)

  /// Leads with deletedAt so the common read — live rows in a month range — is
  /// still one index scan rather than a scan plus a filter.
  @@index([userId, deletedAt, periodMonth, categoryId])
  @@map("actuals")
}

model PeriodLock {
  id          String   @id @default(cuid())
  userId      String
  periodMonth DateTime @db.Date
  lockedAt    DateTime @default(now())
  note        String?

  user User @relation(fields: [userId], references: [Id], onDelete: Cascade)

  @@unique([userId, periodMonth])
  @@map("period_locks")
}

enum ReportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}
model ReportRun {
  id     String @id @default(cuid())
  userId String

  fromMonth DateTime @db.Date
  toMonth   DateTime @db.Date
  categoryId String @default("")

  status ReportStatus @default(PENDING)
  
  error  String?

  totalPlan     Decimal @default(0) @db.Decimal(14, 2)
  totalActual   Decimal @default(0) @db.Decimal(14, 2)
  totalVariance Decimal @default(0) @db.Decimal(14, 2)

  dataVersion Int @default(0)

  requestedAt DateTime  @default(now())
  computedAt  DateTime?

  rows   ReportRow[]
  months ReportMonth[]

  user User @relation(fields: [userId], references: [Id], onDelete: Cascade)

  @@unique([userId, fromMonth, toMonth, categoryId])
  @@index([userId, status])
  @@map("report_runs")
}

model ReportRow {
  id    String @id @default(cuid())
  runId String

  categoryId String
  categoryName String
  periodMonth  DateTime @db.Date

  plan     Decimal @db.Decimal(14, 2)
  actual   Decimal @db.Decimal(14, 2)
  variance Decimal @db.Decimal(14, 2)

  variancePct Decimal? @db.Decimal(10, 4)

  hasActual Boolean
  locked    Boolean

  run ReportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, periodMonth])
  @@map("report_rows")
}

model ReportMonth {
  id          String   @id @default(cuid())
  runId       String
  periodMonth DateTime @db.Date

  plan     Decimal @db.Decimal(14, 2)
  actual   Decimal @db.Decimal(14, 2)
  variance Decimal @db.Decimal(14, 2)

  run ReportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, periodMonth])
  @@map("report_months")
}

