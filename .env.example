# ---------------------------------------------------------------------------
# Planwise — environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored; this file is committed and must never contain a real
# secret. A single .env is used rather than .env.local because the Prisma CLI
# reads .env through prisma.config.ts, while Next reads both — one file keeps
# the app and the migrate command reading the same values.
# ---------------------------------------------------------------------------

# Postgres connection string. Used by Prisma via prisma.config.ts and by the
# pg driver adapter in src/domain/infra/prisma.ts.
# Local example:  postgresql://postgres:postgres@localhost:5432/planwise
# Supabase/Neon:  append ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/planwise?schema=public"

# Signing key for the next-auth JWT. There is no session table — the session is
# a signed cookie — so this secret is the only thing standing between a visitor
# and a forged identity. Must differ per environment.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Canonical origin used to build callback URLs. Required in production; on
# Vercel it is inferred, so it is only strictly needed locally and on other
# hosts. No trailing slash.
#
# It also decides the session cookie's name and Secure flag: an https:// value
# switches next-auth to the __Secure- prefix. Pointing this at http:// in
# production therefore ships the session over plaintext.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google sign-in
#
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and register this exact authorised redirect URI:
#   <NEXTAUTH_URL>/api/auth/callback/google
#
# Leave both unset and the Google button still renders but fails on click —
# there is no local stand-in for Google's consent screen.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Reports
#
# Reports are generated off a Vercel Queue: the request claims a run and drops
# a message, and /api/queues/report computes and stores the result. The cost
# scales with the range, so a ten-year query must not hold an HTTP connection
# open while it runs.
#
# The topic is bound to that route in vercel.json. In development the SDK sends
# to the real queue service and then invokes the handler in-process, so `npm run
# dev` exercises the same path as production — provided the project is linked
# (`vercel link`) and you are online.
#
# Set this to 1 to skip the queue and compute on the request instead, for
# working offline or before the project is linked. Leave it unset otherwise:
# sniffing for "not Vercel" would let a misconfigured deployment quietly serve
# every report from the request thread.
# ---------------------------------------------------------------------------
REPORTS_INLINE=""

# ---------------------------------------------------------------------------
# Mail — Gmail SMTP
#
# Leave GMAIL_* unset and mail is written to the server log instead of being
# sent, so local development and CI need no Google account. Verification links
# are printed in full, which is how you complete a sign-up locally.
# ---------------------------------------------------------------------------

# The Gmail mailbox that authenticates to SMTP.
GMAIL_USER="you@gmail.com"

# A 16-character App Password, NOT the account password — Google rejects plain
# passwords over SMTP. Requires 2-Step Verification on the account, then:
#   https://myaccount.google.com/apppasswords
# Note the free Gmail send cap is ~500 recipients/day (~2,000 on Workspace).
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Envelope sender. Gmail rewrites anything that is not the authenticated
# mailbox, so keep this equal to GMAIL_USER unless you have configured an alias.
MAIL_FROM="Planwise <you@gmail.com>"
